# Vercel Blob storage token. When set, data is read/written via @vercel/blob
# instead of local JSON files under data/. Required in production on Vercel.
BLOB_READ_WRITE_TOKEN=

# Secret bearer token required by POST /api/review/import (used only by
# scripts/import-review-problem.mjs, i.e. Claude's registration script).
# If this is unset, the import endpoint responds 503 and is effectively disabled.
REVIEW_IMPORT_TOKEN=

# Base URL of the deployed site (or http://localhost:3000 for local dev),
# used by scripts/import-review-problem.mjs to build the import request URL.
REVIEW_SITE_URL=
